{
  "manifest_version": 3,
  "name": "PCare Bot - LABKESDA Sumenep",
  "version": "1.0.0",
  "description": "Otomasi input data pasien Prolanis/PRB ke P-Care BPJS, berjalan langsung di Chrome Anda sendiri.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel",
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "https://pcarejkn.bpjs-kesehatan.go.id/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://pcarejkn.bpjs-kesehatan.go.id/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PCare Bot",
    "default_icon": {
      "16": "icons/logo.png",
      "48": "icons/logo.png",
      "128": "icons/logo.png"
    }
  },
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://pcarejkn.bpjs-kesehatan.go.id/*"
      ],
      "js": [
        "content/networkMonitorInject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pcarejkn.bpjs-kesehatan.go.id/*"
      ],
      "js": [
        "content/domHelpers.js",
        "content/select2Helpers.js",
        "shared/pcareData.js",
        "content/loginFlow.js",
        "content/pendaftaranFlow.js",
        "content/pelayananFlow.js",
        "content/cetakFlow.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
